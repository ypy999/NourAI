  "remediation_roadmap_stages_b_to_l": [
    {
      "stage": "Stage B — Data Verification & Balanced Multilingual Split Construction",
      "priority": "P0",
      "actions": [
        "Chunk long QNL Arabic books into uniform passage windows (256-512 chars) and balance token budgets across Arabic, English, and French (33.3% / 33.3% / 33.3% by byte tokens, not just record counts).",
        "Build a clean, leak-free instruction/QA/summarization/translation dataset from real corpus passages without repeating 18 synthetic templates across train/val/test."
      ]
    },
    {
      "stage": "Stage C — Model Verification & Tokenizer/Context Enhancement",
      "priority": "P1",
      "actions": [
        "Verify context_length >= 256 for Arabic byte sequences and ensure Trainer.resume() preserves optimizer and scheduler state across multi-stage runs."
      ]
    },
    {
      "stage": "Stage D & E — Real Pre-Training, Continual Training & SFT Alignment",
      "priority": "P0",
      "actions": [
        "Train on balanced multilingual token splits with proper checkpoint resumption (last.pt) until open-ended generation produces valid words and phrases in AR/EN/FR.",
        "Fine-tune on distinct, non-overlapping instruction/eval sets."
      ]
    },
    {
      "stage": "Stage F, G & H — Multilingual, Capability & Safety Evaluation",
      "priority": "P1",
      "actions": [
        "Evaluate open-ended generation quality (distinct-n, word validity, language identification accuracy, instruction compliance) alongside teacher-forced perplexity."
      ]
    },
    {
      "stage": "Stage I, J & K — Inference, API/UI Integration & Production Hardening",
      "priority": "P0",
      "actions": [
        "Add stop_sequences and cancellation support to InferenceEngine.",
        "Wire NourAIBackend UserManager and SessionManager directly to ProductionDatabase SQLite tables.",
        "Fix ui/index.html authentication (auto-guest/login Bearer token flow), add session delete/rename/copy buttons, and wire TLS socket wrapping + rollback CLI."
      ]
    },
    {
      "stage": "Stage L — Release v1.2.0 Certification",
      "priority": "P1",
      "actions": [
        "Package verified weights, full test suite, and honest benchmark documentation into releases/v1.2.0/."
      ]
    }
  ]
