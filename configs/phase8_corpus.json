{
  "schema_version": 1,
  "approved_source_ids": ["tatoeba_cc0"],
  "target_languages": ["ara", "eng", "fra"],
  "text_fields": ["text", "content", "sentence"],
  "max_download_bytes": 104857600,
  "max_json_bytes": 67108864,
  "max_zip_member_bytes": 2147483648,
  "batch_records": 4096,
  "download": {"timeout_seconds": 30, "retries": 3, "resume_partial": true},
  "supported_formats": ["txt", "text", "jsonl", "ndjson", "json", "csv", "parquet", "zip", "tsv.bz2", "tar.bz2"],
  "language_settings": {
    "ara": {"enabled": true, "minimum_characters": 1},
    "eng": {"enabled": true, "minimum_characters": 1},
    "fra": {"enabled": true, "minimum_characters": 1}
  },
  "normalization": {"unicode_form": "NFC", "newline_form": "LF"},
  "deduplication": {"exact": true, "normalized": true, "profile": "phase7_nfc_casefold_whitespace"},
  "quality": {"scoring_implementation": "data.quality.RECORD_WEIGHTS", "evaluate_all_records": true},
  "license_policy": {"require_verified_for_approved": true, "unknown_license_allowed": false, "manual_review_required_for_mixed_licenses": true},
  "split_ratios": {"train": 0.9, "validation": 0.05, "test": 0.05},
  "random_seed": 1337,
  "raw_directory": "data/raw/external",
  "imported_directory": "data/processed/phase8/imported",
  "normalized_directory": "data/processed/phase8/normalized",
  "splits_directory": "data/processed/phase8/deduplicated/splits",
  "approved_directory": "data/approved",
  "rejected_directory": "data/rejected",
  "metadata_database": "data/metadata/corpus.sqlite3",
  "reports_directory": "reports",
  "report_json": "reports/phase8_corpus_readiness.json",
  "report_markdown": "PHASE_8_CORPUS_READINESS_REPORT.md",
  "dashboard_html": "reports/phase8_corpus_dashboard.html"
}
