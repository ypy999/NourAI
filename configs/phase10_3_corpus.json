  "rejected_directory": "data/processed/phase10_3/rejected",
  "metadata_database": "data/metadata/phase10_3_corpus.sqlite3",
  "reports_directory": "reports/phase10",
  "report_json": "reports/phase10/phase10_3_reproducibility_report.json",
