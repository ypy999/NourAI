{
  "vocab_size": 260,
  "context_length": 128,
  "d_model": 128,
  "n_heads": 4,
  "n_layers": 4,
  "dropout": 0.1,
  "batch_size": 8,
  "learning_rate": 0.0003,
  "device": "cpu",
  "validation_fraction": 0.1,
  "random_seed": 1337,
  "max_document_chars": 2000000,
  "io_batch_lines": 512,
  "cleaning_unicode_normalization": "NFC",
  "cleaning_remove_control_chars": true,
  "cleaning_collapse_whitespace": true,
  "cleaning_preserve_paragraphs": false,
  "cleaning_min_chars": 1,
  "cleaning_reject_short": false,
  "epochs": 3,
  "weight_decay": 0.01,
  "adam_betas": [0.9, 0.999],
  "adam_epsilon": 1e-8,
  "warmup_steps": 0,
  "gradient_accumulation_steps": 1,
  "gradient_clip_norm": 1.0,
  "scheduler_type": "cosine",
  "precision": "fp32",
  "validation_interval": 100,
  "checkpoint_interval": 100,
  "early_stopping": false,
  "early_stopping_patience": 3,
  "early_stopping_min_delta": 0.0,
  "max_training_steps": 0,
  "checkpoint_keep": 3
}
